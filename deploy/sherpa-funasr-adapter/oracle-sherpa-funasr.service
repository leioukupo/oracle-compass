[Unit]
Description=Oracle Compass sherpa-onnx FunASR-compatible ASR
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/oracle-voice/asr
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=1
Environment=PORT=10096
ExecStart=/opt/oracle-voice/asr/start_adapter.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
